{
  "name": "bot-news",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=index.mjs",
    "start": "node --env-file=.env index.mjs",
    "dev": "node --env-file=.env src/index.ts",
    "now": "node --env-file=.env src/index.ts --now",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
